rules_version = '2';

// Storage, unlike Firestore, does need direct client access: admins upload
// itinerary photographs from the browser, and travellers attach photos to a
// review. Sending those through a route handler would mean pushing whole
// image payloads through a serverless function for no benefit.
//
// So these rules matter. They are the real control, not a formality.
service firebase.storage {
  match /b/{bucket}/o {

    // Itinerary photographs are shown to every visitor, so they are public to
    // read. Writing needs a signed-in admin — the `admin` custom claim is set
    // by a one-off script, never by anything reachable over HTTP.
    match /itineraries/{itineraryId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && isImageUnder(8 * 1024 * 1024);
    }

    // Review photos. Readable, because an approved review shows them; the
    // application only ever renders URLs stored against an approved review,
    // so an unapproved photo is unreachable in practice.
    //
    // Writes are closed entirely. Review photographs are uploaded by the
    // server (see `lib/reviews/store.ts`) after it has checked the invite
    // token, the file count, the decoded size and the content type. Rules
    // cannot see the decoded size of a data URL and there is no signed-in
    // account to attribute a traveller's upload to, so doing it server-side
    // is both the only way to enforce the limits and the simpler one. The
    // Admin SDK bypasses this rule by design.
    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not named above is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }

  function isImageUnder(maxBytes) {
    return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
  }
}
