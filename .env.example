# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Site ---------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://naturewalksrilanka.com

# --- Admin panel --------------------------------------------------------
# All three are required. There are no fallbacks: if any is missing, admin
# sign-in fails closed and the panel cannot be entered at all.
ADMIN_EMAIL=you@example.com
# Use a long, random password. Do not reuse one from anywhere else.
ADMIN_PASSWORD=
# Signs the admin session cookie. Anyone who learns this value can forge a
# valid session without the password, so treat it as a secret of its own and
# use a fresh random string per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Itinerary storage --------------------------------------------------
# Vercel Blob read/write token, used by lib/itineraries/blobArchive.ts.
BLOB_READ_WRITE_TOKEN=

# --- Translation --------------------------------------------------------
# Google Gemini key for the admin translation panel. Optional: without it the
# translation feature returns 503 and the rest of the site is unaffected.
GOOGLE_AI_API_KEY=
