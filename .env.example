# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Site ---------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://naturewalksrilanka.com

# --- Admin panel --------------------------------------------------------
# All three are required. There are no fallbacks: if any is missing, admin
# sign-in fails closed and the panel cannot be entered at all.
ADMIN_EMAIL=you@example.com
# Use a long, random password. Do not reuse one from anywhere else.
ADMIN_PASSWORD=
# Signs the admin session cookie. Anyone who learns this value can forge a
# valid session without the password, so treat it as a secret of its own and
# use a fresh random string per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Firebase (server / Admin SDK) --------------------------------------
# From a service account key: Firebase console > Project settings >
# Service accounts > Generate new private key. These three are required
# together; without them every Firebase-backed feature reports itself as
# unavailable and the rest of the site carries on unaffected.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole PEM block on ONE line, with real newlines written as \n. Keep the
# surrounding double quotes. This is a genuine secret: it grants full
# administrative access to the project and bypasses all security rules.
FIREBASE_PRIVATE_KEY=""
# e.g. your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# --- Firebase (browser) -------------------------------------------------
# From Firebase console > Project settings > Your apps > Web app config.
# These are public by design — a web API key identifies the project, it does
# not authorise anything. Security comes from Auth and the rules files.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Itinerary storage --------------------------------------------------
# Vercel Blob read/write token, used by lib/itineraries/blobArchive.ts.
BLOB_READ_WRITE_TOKEN=

# --- Translation --------------------------------------------------------
# Google Gemini key for the admin translation panel. Optional: without it the
# translation feature returns 503 and the rest of the site is unaffected.
GOOGLE_AI_API_KEY=
