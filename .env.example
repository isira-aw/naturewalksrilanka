# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Site ---------------------------------------------------------------
# Absolute origin, used for canonical URLs, hreflang alternates, the sitemap,
# robots.txt, llms.txt, Open Graph and JSON-LD. No trailing slash. Read in one
# place only, `lib/seo/site.ts`. Set this on preview deployments too, to the
# preview's own origin — a preview claiming the production origin invites
# Google to index the preview in place of the real site.
NEXT_PUBLIC_SITE_URL=https://naturewalksrilanka.com
# Google Search Console verification token, HTML-tag method: Search Console >
# add property > "HTML tag" > copy the `content="..."` value only (not the
# whole tag). Optional — left blank, no verification meta tag is rendered, so
# only set it on the deployment that serves the real domain. The token
# identifies the property; it grants nothing on its own.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token, HTML Meta Tag method: Bing
# Webmaster Tools > add site > "HTML Meta Tag" > copy the `content="..."` value
# only. Optional and public on the same terms as the Google one above; the same
# sitemap.xml is submitted to both. Renders as `msvalidate.01`.
# Step-by-step in `docs/seo.md`.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Admin panel --------------------------------------------------------
# Nothing goes here. Admin sign-in is Firebase Authentication only: a staff
# member signs in with their own Google account, and access is granted by the
# `admin` custom claim plus an entry in the `staff` Firestore collection.
# See `scripts/grant-admin.mjs` and docs/FIREBASE_INTEGRATION.md §5.
#
# The old ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_SESSION_SECRET shared password
# has been removed. If they are still set in Vercel, delete them there too —
# nothing reads them, and a live secret nobody uses is a secret nobody rotates.

# --- Firebase (server / Admin SDK) --------------------------------------
# Accounts and documents only. Photographs live on Cloudinary, below, so
# there is no Storage bucket to name here.
# From a service account key: Firebase console > Project settings >
# Service accounts > Generate new private key. These three are required
# together; without them every Firebase-backed feature reports itself as
# unavailable and the rest of the site carries on unaffected.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole PEM block on ONE line, with real newlines written as \n. Keep the
# surrounding double quotes. This is a genuine secret: it grants full
# administrative access to the project and bypasses all security rules.
FIREBASE_PRIVATE_KEY=""

# --- Firebase (browser) -------------------------------------------------
# From Firebase console > Project settings > Your apps > Web app config.
# These are public by design — a web API key identifies the project, it does
# not authorise anything. Security comes from Auth and the rules files.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cloudinary (photographs) -------------------------------------------
# Where every uploaded photograph lives: itinerary images and review photos.
# Dashboard > Settings > API Keys. Without these, uploads report themselves
# unavailable and the rest of the site is unaffected.
#
# The cloud name is public — it is in the host of every delivery URL. The key
# and the secret are not. The secret signs uploads and never reaches the
# browser: the admin form asks `/api/admin/cloudinary-signature` for a
# short-lived signature instead, and that route decides the folder itself.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Translation --------------------------------------------------------
# Google Gemini key for the admin translation panel. Optional: without it the
# translation feature returns 503 and the rest of the site is unaffected.
GOOGLE_AI_API_KEY=
